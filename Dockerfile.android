FROM node:22-bookworm-slim

ARG ANDROID_COMMAND_LINE_TOOLS_VERSION=13114758
ARG ANDROID_API_LEVEL=36
ARG ANDROID_BUILD_TOOLS_VERSION=36.0.0

ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_AVD_HOME=/opt/android-avd
ENV ANDROID_AVD_NAME=decisioneats-api-36
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/emulator:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/36.0.0:$PATH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        libasound2 \
        libdbus-1-3 \
        libfontconfig1 \
        libglu1-mesa \
        libnss3 \
        libpulse0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxi6 \
        libxrandr2 \
        libxtst6 \
        openjdk-17-jdk-headless \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir --parents "$ANDROID_HOME/cmdline-tools" "$ANDROID_AVD_HOME" \
    && curl --fail --location --silent --show-error \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_COMMAND_LINE_TOOLS_VERSION}_latest.zip" \
        --output /tmp/android-command-line-tools.zip \
    && unzip -q /tmp/android-command-line-tools.zip -d "$ANDROID_HOME/cmdline-tools" \
    && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" \
    && rm /tmp/android-command-line-tools.zip \
    && yes | sdkmanager --licenses > /dev/null \
    && sdkmanager --install \
        "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
        "emulator" \
        "platform-tools" \
        "platforms;android-${ANDROID_API_LEVEL}" \
        "system-images;android-${ANDROID_API_LEVEL};google_apis;x86_64" \
    && echo no | avdmanager create avd \
        --force \
        --name "$ANDROID_AVD_NAME" \
        --package "system-images;android-${ANDROID_API_LEVEL};google_apis;x86_64"

WORKDIR /workspace

COPY package*.json ./
RUN npm ci

COPY . ./

CMD ["npm", "run", "android:test:build"]
