# ---------------------------------------------------------------------------
# DecisionEats environment. Copy to `.env` and fill in. `.env` is gitignored.
#
# ONLY these five variables may be public. Anything prefixed EXPO_PUBLIC_ is
# compiled into the client bundle and is readable by anyone who downloads the
# app. Secret third-party credentials NEVER go here — runtime vendor secrets
# live in Supabase and are read only inside Edge Functions.
# See docs/06_API_KEYS_AND_ENV.md.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijk.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Safe to ship: RLS is what protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Canonical hosted web origin used for OAuth redirects. Leave blank for local
# development; set this to the Pages URL in the hosted build environment.
EXPO_PUBLIC_SITE_URL=

# PostHog project token and API host. Both are public client configuration.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ---------------------------------------------------------------------------
# NOT read by the client. Listed here so nobody has to guess the names.
# Set these with: supabase secrets set NAME=value
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=        # analyze-pantry-photo Edge Function
# SPOONACULAR_API_KEY=   # optional Spoonacular search Edge Function (Milestone 4)
#
# Comma-separated exact origins a browser may read Edge Function responses
# from (CORS). Unset keeps the open default; set once the production web
# origin is known. Native apps send no Origin header and are unaffected.
# ALLOWED_ORIGINS=https://decisioneats.example.com
# Photo-scan budgets. These are read only by analyze-pantry-photo and are
# enforced again by the private database function. Keep the global default
# conservative until real usage and provider cost are measured.
# DAILY_SCAN_LIMIT=20
# GLOBAL_DAILY_SCAN_LIMIT=1000
#
# For local `supabase functions serve --env-file supabase/.env.local` only
# (the hosted runtime injects these automatically): SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY. The service-role key bypasses RLS — never
# prefix it EXPO_PUBLIC_ and never commit it.

# ---------------------------------------------------------------------------
# Build-time and developer tooling. Never read by client bundle.
# ---------------------------------------------------------------------------
# THEMEALDB_API_KEY=1    # "1" is the free public test key
